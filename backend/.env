# Copy this file to .env and fill in your values.
# Used for local Lambda testing (boto3 picks up AWS_* vars automatically).

# -----------------------------------------------------------------------------
# AWS (local development only — deployed Lambdas use their execution role)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# DynamoDB table names (must match what you created in the AWS console)
# -----------------------------------------------------------------------------
USERS_TABLE=Users
COLLEGE_DOMAINS_TABLE=CollegeDomains
JOBS_TABLE=Jobs

# -----------------------------------------------------------------------------
# Cognito (for reference and local testing scripts)
# Lambdas receive userPoolId from the trigger event at runtime — set these on
# the Lambda environment in the console when deploying, not only here.
# -----------------------------------------------------------------------------
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_USER_POOL_ARN=arn:aws:cognito-idp:us-east-1:123456789012:userpool/us-east-1_XXXXXXXXX
