# -----------------------------------------------------------------------------
# DynamoDB table names (must match what you created in the AWS console)
# -----------------------------------------------------------------------------
USERS_TABLE=Users
COLLEGE_DOMAINS_TABLE=CollegeDomains
JOBS_TABLE=Jobs

# -----------------------------------------------------------------------------
# AWS (region must match your Cognito pool and API Gateway)
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1

# -----------------------------------------------------------------------------
# Cognito (for reference and local testing scripts)
# Lambdas receive userPoolId from the trigger event at runtime — set these on
# the Lambda environment in the console when deploying, not only here.
# -----------------------------------------------------------------------------
COGNITO_USER_POOL_ID=ap-south-1_s0f7Kwug8
COGNITO_APP_CLIENT_ID=252uufp7vo6qoum64tmoichtq2
COGNITO_USER_POOL_ARN=arn:aws:cognito-idp:ap-south-1:470361396576:userpool/ap-south-1_s0f7Kwug8
