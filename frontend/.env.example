# Copy this file to .env and fill in your values.
# Vite exposes only variables prefixed with VITE_ to the browser.

# -----------------------------------------------------------------------------
# AWS region
# -----------------------------------------------------------------------------
VITE_AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Cognito (same User Pool and app client you created in the AWS console)
# App client must have no secret (public client for SPA).
# -----------------------------------------------------------------------------
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# API Gateway base URL (set when your backend API is deployed)
# -----------------------------------------------------------------------------
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
